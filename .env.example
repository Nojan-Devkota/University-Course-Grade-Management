# Copy to .env for local development. Do not commit .env.

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db
SQL_ECHO=false
TESTING=false

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Staff login
STAFF_USERNAME=admin
STAFF_PASSWORD=adminpass123
